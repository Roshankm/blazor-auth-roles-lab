@page "/leave"
@attribute [Authorize]
@inject LeaveService Leave

<PageTitle>My leave</PageTitle>

<h1>Leave requests</h1>
<p class="text-muted">
    Resource-based authorization: the <strong>Edit</strong> button is shown per request with
    <code>&lt;AuthorizeView Policy="EditLeaveRequest" Resource="request"&gt;</code>. Owners can edit their own pending
    requests; admins can edit any request.
</p>

<table class="table">
    <thead><tr><th>#</th><th>Employee</th><th>Dates</th><th>Status</th><th></th></tr></thead>
    <tbody>
        @foreach (var request in Leave.All())
        {
            <tr data-test="request-@request.Id">
                <td>@request.Id</td>
                <td>@request.EmployeeUserName</td>
                <td>@request.From &ndash; @request.To</td>
                <td>@request.Status</td>
                <td>
                    <AuthorizeView Policy="@Policies.EditLeaveRequest" Resource="request">
                        <Authorized><button class="btn btn-sm btn-outline-primary" data-test="edit">Edit</button></Authorized>
                        <NotAuthorized><span class="small text-muted">Read only</span></NotAuthorized>
                    </AuthorizeView>
                </td>
            </tr>
        }
    </tbody>
</table>
